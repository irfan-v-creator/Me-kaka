rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' ||
        request.auth.token.email == 'miv3game@gmail.com' ||
        request.auth.token.email == 'konami5miv@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Products Collection:
    // Anyone (even unauthenticated users) can READ products, but ONLY authenticated Admins can WRITE/CREATE/DELETE products.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Orders Collection:
    // Users can CREATE an order. Only the specific user who created the order or an authenticated Admin can READ/WRITE that order data.
    match /orders/{orderId} {
      allow create: if true;
      allow get, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 3. Cart Collection:
    // Users can only read and write their own data based on their request.auth.uid.
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Users Collection:
    // Users can only read and write their own data based on their request.auth.uid.
    // Allow read for admins as well, so admins can manage and check profiles when reviewing orders.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Reviews Collection:
    // Secure reviews collection so that product reviews feature remains functional.
    match /reviews/{reviewId} {
      allow read, create, delete: if true;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
